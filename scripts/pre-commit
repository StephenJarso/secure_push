#!/bin/bash
# Pre-commit hook for secure-push
# This hook runs secure-push on staged files before allowing a commit

set -e

echo "Running secure-push pre-commit check..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo "No files to check."
    exit 0
fi

# Create a temporary directory with staged files
TEMP_DIR=$(mktemp -d)
trap "rm -rf $TEMP_DIR" EXIT

# Copy staged files to temp directory maintaining structure
for FILE in $STAGED_FILES; do
    # Skip deleted files
    if [ ! -f "$FILE" ]; then
        continue
    fi

    # Create directory structure
    mkdir -p "$TEMP_DIR/$(dirname "$FILE")"

    # Copy file
    cp "$FILE" "$TEMP_DIR/$FILE"
done

# Run secure-push on the temp directory
if command -v secure-push &> /dev/null; then
    secure-push "$TEMP_DIR"
elif [ -f "./secure-push" ]; then
    ./secure-push "$TEMP_DIR"
else
    echo "Warning: secure-push not found. Install it or run 'go build -o secure-push ./cmd/secure-push'"
    echo "Skipping pre-commit check."
    exit 0
fi

echo "✓ Pre-commit check passed!"
